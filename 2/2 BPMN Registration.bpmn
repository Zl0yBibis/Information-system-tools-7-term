<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Registration" targetNamespace="https://example.org/registration" exporter="bpmn-js compatible model">
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Participant" name="Регистрация пользователя на сайте" processRef="Process"/>
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="User" name="Пользователь">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="System" name="Система">
        <bpmn:flowNodeRef>Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Начало регистрации">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Input" name="Ввести имя, email и пароль">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="Check" name="Проверить корректность данных">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway" name="Данные корректны?" default="F5">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Error" name="Показать ошибки ввода">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Email" name="Отправить письмо для подтверждения">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Confirm" name="Подтвердить регистрацию по ссылке в письме">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activate" name="Активировать учётную запись">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Успешная регистрация">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Input"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Input" targetRef="Check"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Check" targetRef="Gateway"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Gateway" targetRef="Email" name="Да"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Gateway" targetRef="Error" name="Нет"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Error" targetRef="Input" name="Исправить данные"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Email" targetRef="Confirm"/>
    <bpmn:sequenceFlow id="F8" sourceRef="Confirm" targetRef="Activate"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Activate" targetRef="End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="Participant_di" bpmnElement="Participant" isHorizontal="true">
        <dc:Bounds x="70" y="100" width="1430" height="550"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="User_di" bpmnElement="User" isHorizontal="true">
        <dc:Bounds x="100" y="100" width="1400" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="System_di" bpmnElement="System" isHorizontal="true">
        <dc:Bounds x="100" y="320" width="1400" height="330"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="160" y="180" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="125" y="226" width="110" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Input_di" bpmnElement="Input">
        <dc:Bounds x="250" y="158" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Check_di" bpmnElement="Check">
        <dc:Bounds x="460" y="388" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_di" bpmnElement="Gateway" isMarkerVisible="true">
        <dc:Bounds x="665" y="403" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="630" y="350" width="110" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Error_di" bpmnElement="Error">
        <dc:Bounds x="460" y="528" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Email_di" bpmnElement="Email">
        <dc:Bounds x="780" y="388" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Confirm_di" bpmnElement="Confirm">
        <dc:Bounds x="990" y="158" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activate_di" bpmnElement="Activate">
        <dc:Bounds x="1190" y="388" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="1400" y="410" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1365" y="456" width="110" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="196" y="198"/>
        <di:waypoint x="250" y="198"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="400" y="198"/>
        <di:waypoint x="430" y="198"/>
        <di:waypoint x="430" y="428"/>
        <di:waypoint x="460" y="428"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="610" y="428"/>
        <di:waypoint x="665" y="428"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="715" y="428"/>
        <di:waypoint x="780" y="428"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="730" y="402" width="30" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="690" y="453"/>
        <di:waypoint x="690" y="568"/>
        <di:waypoint x="610" y="568"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="698" y="485" width="35" height="20"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="460" y="568"/>
        <di:waypoint x="325" y="568"/>
        <di:waypoint x="325" y="238"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="330" y="330" width="110" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="930" y="428"/>
        <di:waypoint x="960" y="428"/>
        <di:waypoint x="960" y="198"/>
        <di:waypoint x="990" y="198"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="1150" y="198"/>
        <di:waypoint x="1265" y="198"/>
        <di:waypoint x="1265" y="388"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1340" y="428"/>
        <di:waypoint x="1400" y="428"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
